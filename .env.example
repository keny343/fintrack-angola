# PostgreSQL (docker-compose)
POSTGRES_USER=fintrack
POSTGRES_PASSWORD=fintrack_dev
POSTGRES_DB=fintrack

# Backend
DATABASE_URL=postgresql://fintrack:fintrack_dev@localhost:5432/fintrack
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
COOKIE_SECURE=false
# Set to true only when running behind a load balancer (Render, nginx).
TRUST_PROXY=false
# Leave unset unless the browser calls the API on another domain — see docs/DEPLOYMENT.md.
# COOKIE_SAMESITE=none

# Monthly summary written by a language model. Leave AI_API_KEY unset and the
# API still answers, with a summary it composes itself - see docs/AI.md.
# AI_API_KEY=sk-...
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
# AI_MAX_TOKENS=250
# AI_TIMEOUT_MS=8000
# AI_DAILY_LIMIT=40

# Frontend (Vite)
VITE_API_URL=http://localhost:4000

# PostgreSQL (docker-compose)
POSTGRES_USER=fintrack
POSTGRES_PASSWORD=fintrack_dev
POSTGRES_DB=fintrack

# Backend
DATABASE_URL=postgresql://fintrack:fintrack_dev@localhost:5432/fintrack
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
COOKIE_SECURE=false
# Set to true only when running behind a load balancer (Render, nginx).
TRUST_PROXY=false
# Leave unset unless the browser calls the API on another domain — see docs/DEPLOYMENT.md.
# COOKIE_SAMESITE=none

# Frontend (Vite)
VITE_API_URL=http://localhost:4000
